{
  "name": "file-type-mime",
  "version": "0.4.7",
  "description": "Utility to parse mime type from a file content",
  "keywords": [
    "application",
    "audio",
    "bytes",
    "content",
    "content-type",
    "file",
    "font",
    "ftyp",
    "image",
    "json",
    "mime",
    "mime-type",
    "parse",
    "pdf",
    "text",
    "type",
    "video",
    "zip"
  ],
  "homepage": "https://file-type-mime.vercel.app",
  "license": "MIT",
  "author": {
    "name": "Edmundas Ramanauskas",
    "email": "edmundas.ramanauskas@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/redmundas/file-type-mime.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "check": "biome check src",
    "format": "biome format src --write",
    "build": "tsdown",
    "test": "vitest run",
    "execute": "node node-test.js",
    "coverage": "vitest run --coverage",
    "release": "pnpm build && pnpm publish",
    "validate": "pnpm build && pnpm execute"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "nyc": {
    "all": true,
    "exclude": [
      "**/*.d.ts",
      "**/*.spec.ts",
      "**/index.ts",
      "data",
      "dist"
    ],
    "extension": [
      ".ts"
    ]
  }
}
